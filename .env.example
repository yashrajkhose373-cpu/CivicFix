# StudySync - Database Configuration Example

# MySQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/studysync_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root

# Server Port
SERVER_PORT=8080

# Active Profile: set to 'dev' to use in-memory H2 without MySQL setup, or leave empty for MySQL default
# SPRING_PROFILES_ACTIVE=dev
